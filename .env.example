# Copiar a .env para desarrollo local.
# En Render, configurar estas variables en Dashboard → Environment del Web Service.

# --- Base de datos MySQL (Aiven) ---
DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:24709/defaultdb?sslMode=REQUIRED&allowPublicKeyRetrieval=true
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET_TOKEN=your_webhook_secret_here

# --- URL pública del backend (webhook auto-registro al arrancar) ---
# Local con ngrok:  APP_BASE_URL=https://xxxx.ngrok-free.dev
# Render:          RENDER_EXTERNAL_URL (inyectada automáticamente)
# Alternativa:      APP_URL=https://your-backend.onrender.com
APP_BASE_URL=
APP_URL=
RENDER_EXTERNAL_URL=

# --- Puerto (Render inyecta PORT; local usa 8080 por defecto) ---
PORT=8080
SERVER_PORT=8080

# --- CORS (orígenes del frontend en Vercel, separados por coma) ---
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tu-app.vercel.app
